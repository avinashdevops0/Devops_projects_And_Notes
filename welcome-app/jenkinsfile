pipeline {
    agent any

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Code') {
            steps {
                git branch: 'simple',
                    url: 'https://github.com/avinashdevops0/Devops_projects_And_Notes.git'
            }
        }

        stage('Build') {
            steps {
                dir('welcome-app') {
                    sh 'docker-compose build'
                }
            }
        }

        stage('Running Containers') {
            steps {
                dir('welcome-app') {
                    sh 'docker-compose up -d'
                }
            }
        }
    }
}
